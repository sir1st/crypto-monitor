# Copy to .env and fill in. Your .env is gitignored — never commit it.
#
# accounts_config.json refers to these variables BY NAME, so the names you use
# here must match its api_key_env / api_secret_env fields.

# ---------------------------------------------------------------------------
# Testnet — start here
# ---------------------------------------------------------------------------
USE_TESTNET=true
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# ---------------------------------------------------------------------------
# Live accounts
# ---------------------------------------------------------------------------
# These keys need TRADE permission — this bot places and closes real orders.
# Do not enable a live account until you have watched it behave on testnet.
# Add one pair per account and reference the names in accounts_config.json.
BYBIT_API_KEY=
BYBIT_API_SECRET=

BYBIT_API_KEY_2=
BYBIT_API_SECRET_2=

BYBIT_API_KEY_3=
BYBIT_API_SECRET_3=

# ---------------------------------------------------------------------------
# Telegram (optional)
# ---------------------------------------------------------------------------
# Signal alerts and remote commands. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Separate bot/chat for balance reports. Falls back to the pair above if unset.
REPORTS_BOT_TOKEN=
REPORTS_CHAT_ID=

# ---------------------------------------------------------------------------
# LLM analysis (optional)
# ---------------------------------------------------------------------------
# s1.py can ask an LLM to comment on a signal before acting. Leave the keys blank
# to skip that step entirely — the strategy still runs.
#
# WHICH MODEL IS USED, AND HOW TO CHANGE IT
#   AI_MODEL (or MODEL) sets the model id. Nothing is hardcoded.
#   Default when unset: gpt-5-mini
#
#   Provider is chosen by which key is present:
#     OPENROUTER_API_KEY set  -> routed via https://openrouter.ai/api/v1
#     otherwise               -> OpenAI directly, using OPENAI_API_KEY
#
#   Examples:
#     AI_MODEL=gpt-5-mini                     (OpenAI, cheap)
#     AI_MODEL=gpt-5                          (OpenAI, stronger)
#     AI_MODEL=anthropic/claude-sonnet-5      (via OpenRouter)
#     AI_MODEL=anthropic/claude-opus-5        (via OpenRouter, strongest)
#
#   OpenRouter ids are "vendor/model"; OpenAI ids are bare. Check the provider's
#   model list before setting one — an unknown id fails at call time, not startup.
AI_MODEL=gpt-5-mini
# MODEL is accepted as an alias for AI_MODEL, for older configs.
MODEL=

OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Web search used by some analysis paths.
TAVILY_API_KEY=

# Title used in the Telegram balance report header.
REPORT_TITLE=ACCOUNT BALANCE & TRADING REPORT
