# Copy this file to .env and fill in what you need.
# .env is gitignored — never commit real credentials.
#
# Nothing here is required: `npm run dev` works with an empty .env. Candles,
# prices and market hours need no configuration at all.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=5000

# Loopback only, by default. THE API HAS NO AUTHENTICATION — anything that can
# reach this port can read exchange balances and add or delete accounts. Only
# change this if you are putting an authenticating reverse proxy in front.
HOST=127.0.0.1

# Where the local SQLite file lives. Created automatically on first boot.
DATABASE_PATH=./data/vale.db

# How often active price alerts are re-checked, in milliseconds.
ALERT_POLL_MS=30000

# ---------------------------------------------------------------------------
# Exchange (optional)
# ---------------------------------------------------------------------------
# Candles, prices and market hours work with no keys. Keys are only needed for
# positions, balances and realised P&L.
#
# Prefer adding accounts in the Accounts tab — that supports several at once and
# stores them in the database. These variables are a single-account fallback,
# used only when no accounts are configured.
#
# Use read-only API keys. This app never places orders.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# ---------------------------------------------------------------------------
# AI layer (optional)
# ---------------------------------------------------------------------------
# Leave the keys blank to run without AI; those endpoints then return 503.
# Model ids and pricing live in server/ai/config.ts — add a model there to use
# one that isn't listed.

# anthropic | openai — must match the provider that owns AI_MODEL.
AI_PROVIDER=anthropic
# e.g. claude-opus-5, claude-sonnet-5, claude-haiku-4-5, gpt-5.1
AI_MODEL=claude-opus-5
# low | medium | high | xhigh | max
AI_EFFORT=medium
AI_MAX_TOKENS=8000

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# MCP server (optional) — only read by server/mcp
# ---------------------------------------------------------------------------
# Where the MCP server should reach the running app.
VALE_API_URL=http://127.0.0.1:5000
